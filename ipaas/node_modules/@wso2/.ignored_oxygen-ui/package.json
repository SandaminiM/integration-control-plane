{
  "name": "@wso2/oxygen-ui",
  "version": "0.5.0",
  "description": "WSO2 Oxygen UI | Design System - Powered with Material-UI component library with TypeScript support",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "bin": {
    "oxygen-ui": "./bin/cli.js"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    ".claude",
    ".ai",
    "bin"
  ],
  "sideEffects": [
    "src/styles/Themes/theme.css",
    "dist/styles/Themes/theme.css"
  ],
  "keywords": [
    "wso2",
    "oxygen-ui",
    "design-system",
    "material-ui",
    "mui",
    "react",
    "typescript",
    "components",
    "ui-library"
  ],
  "author": "WSO2 LLC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wso2/oxygen-ui.git"
  },
  "bugs": {
    "url": "https://github.com/wso2/oxygen-ui/issues"
  },
  "homepage": "https://github.com/wso2/oxygen-ui#readme",
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "7.3.4",
    "@mui/x-data-grid": "8.16.0",
    "@mui/x-date-pickers": "8.16.0",
    "@mui/x-tree-view": "8.14.0",
    "date-fns": "4.1.0",
    "prismjs": "^1.30.0"
  },
  "peerDependencies": {
    "@wso2/oxygen-ui-icons-react": ">=0.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.45.0",
    "@typescript-eslint/parser": "8.45.0",
    "@vitest/ui": "4.0.6",
    "esbuild": "0.25.11",
    "eslint": "9.12.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "rimraf": "6.1.0",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "4.0.6",
    "@wso2/esbuild-plugin-inline-css-fonts": "^0.0.1",
    "@wso2/oxygen-ui-icons-react": "^0.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json && node esbuild.config.js",
    "build:watch": "node esbuild.config.js --watch",
    "dev": "node esbuild.config.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  }
}